<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_tn_payment_method_mapping_list" model="ir.ui.view">
        <field name="name">tn.payment.method.mapping.list</field>
        <field name="model">tn.payment.method.mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="active"/>
                <field name="company_id"/>
                <field name="payment_method_tn"/>
                <field name="gateway_tn"/>
                <field name="journal_id"/>
            </list>
        </field>
    </record>

    <record id="view_tn_payment_method_mapping_form" model="ir.ui.view">
        <field name="name">tn.payment.method.mapping.form</field>
        <field name="model">tn.payment.method.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="company_id"/>
                        <field name="payment_method_tn"/>
                        <field name="gateway_tn"/>
                        <field name="journal_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_tn_payment_method_mapping" model="ir.actions.act_window">
        <field name="name">Mapeo Metodos de Pago TN</field>
        <field name="res_model">tn.payment.method.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_tn_payment_method_mapping"
        name="Mapeo Metodos de Pago"
        parent="odoo_tienda_nube.menu_settings_tn"
        action="action_open_tn_payment_method_mapping"
        sequence="30"
    />
</odoo>
