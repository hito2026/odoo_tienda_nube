<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_company_form_tn_auto_account_inherit" model="ir.ui.view">
        <field name="name">res.company.tn.auto.account.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="odoo_tienda_nube.view_company_form_tn"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tn_config_confirmation_sale']" position="after">
                <separator string="Facturacion y Pagos Automaticos TN"/>
                <field name="tn_auto_invoice_trigger" widget="radio"/>
                <field name="tn_invoice_journal_id"/>
            </xpath>
        </field>
    </record>
</odoo>
