<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_company_form_tn_l10n_ar" model="ir.ui.view">
        <field name="name">Datos fiscales argentinos para Tienda Nube</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="odoo_tienda_nube.view_company_form_tn" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tn_force_tax_ids']" position="after">
                <field name="tn_default_afip_responsibility_id"
                       options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="tn_update_partner_from_padron"/>
            </xpath>
        </field>
    </record>
</odoo>
