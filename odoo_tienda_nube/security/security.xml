<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_tienda_nube_user" model="res.groups">
        <field name="name">Tienda Nube</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Los administradores siempre ven el menu de Tienda Nube -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('odoo_tienda_nube.group_tienda_nube_user'))]"/>
    </record>
</odoo>