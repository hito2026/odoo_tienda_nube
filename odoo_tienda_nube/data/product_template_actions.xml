<odoo>
    <record id="server_action_create_tn" model="ir.actions.server">
        <field name="name">Crear en Tienda Nube</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
        for record in records:
        record.create_tn()
        ]]></field>
    </record>

    <record id="server_action_update_price_tn" model="ir.actions.server">
        <field name="name">Actualizar precio en Tienda Nube</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
        env.company.update_product_price_tn(records)
        ]]></field>
    </record>

    <record id="server_action_update_product_image_tn" model="ir.actions.server">
        <field name="name">Actualizar imagen en Tienda Nube</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
        for record in records:
        record.update_product_image_tn()
        ]]></field>
    </record>

    <record id="server_action_update_tn" model="ir.actions.server">
        <field name="name">Actualizar en Tienda Nube</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
        for record in records:
        record.update_tn()
        ]]></field>
    </record>

    <!-- Copia peso/medidas de la pestaña Inventario a los campos de Tienda Nube -->
    <record id="server_action_copy_inventory_dimensions_tn" model="ir.actions.server">
        <field name="name">Copiar medidas de Inventario a Tienda Nube</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_tn_copy_inventory_dimensions()</field>
    </record>

    <record id="server_action_copy_inventory_dimensions_tn_variant" model="ir.actions.server">
        <field name="name">Copiar medidas de Inventario a Tienda Nube</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_tn_copy_inventory_dimensions()</field>
    </record>
</odoo>
